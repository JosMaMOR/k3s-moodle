# ==============================================================================
# cluster.env — Configuración de red del clúster K3s HA
# Editar estos valores al cambiar de entorno de red.
# Consumido por: 01-prepareAlma9k3s.sh, 04-deploy-all.sh y 07-galera-maxscale.sh
# ==============================================================================

K3S_VERSION="v1.35.5+k3s1" # Versión de K3s — fijada para reproducibilidad (no usar "latest")
KVVERSION="v1.2.0" # Version de kube-vip
GALERA_VERSION="26.4.23"
GARBD_IMAGE="localhost/galera-arbitrator:${GALERA_VERSION}"  # imagen local de la Pi (sin registry)

# IPs fijas de los nodos (reservadas por MAC en el router)
NODE_A_IP="192.168.10.100"
NODE_B_IP="192.168.10.98"
NODE_PI_IP="192.168.10.150"
CLUSTER_VIP="192.168.10.200" # IP Virtual flotante (kube-vip). DEBE estar FUERA del pool DHCP.
NODE_TOKEN="" # Token de conexion para los nodos B y Pi

MOODLE_DOMAIN="mcc.tesoem.edu.mx" # Dominio del Moodle (para tls-san e Ingress)

GALERA_CLUSTER_NAME="moodle-galera" # el galera.name; garbd debe usar el mismo
MOODLE_NS="moodle-prod"
NODE_A="k3s-moodle-master"
NODE_B="node-b-k3s-moodle"
NODE_PI="raspberry-k3s-moodle"
LOCAL_REGISTRY="localhost:5000"