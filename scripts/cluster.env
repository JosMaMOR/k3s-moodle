# ════════════════════════════════════════════════════════════════
# cluster.env — Configuración de red del clúster K3s HA
# Editar estos valores al cambiar de entorno de red.
# Consumido por: 01-prepareAlma9k3s.sh, 06-deploy-all.sh
# ════════════════════════════════════════════════════════════════

# Versión de K3s — fijada para reproducibilidad (no usar "latest")
K3S_VERSION="v1.35.5+k3s1"

# IP Virtual flotante (kube-vip). DEBE estar FUERA del pool DHCP.
# Pool DHCP actual (testing): .10–.126  →  VIP segura en .2–.9
CLUSTER_VIP="192.168.88.5"

# IPs fijas de los nodos (reservadas por MAC en el router)
NODE_A_IP="192.168.88.15"      # este servidor (control-plane inicial)
NODE_B_IP="192.168.88.32"      # Fase 3 — aún sin unir
NODE_PI_IP="192.168.88.99"     # Fase 3 — aún sin configurar

# Dominio del Moodle (para tls-san e Ingress)
MOODLE_DOMAIN="mcc.tesoem.edu.mx"